# Template for .env.local — safe to commit. Copy to .env.local and fill in.
#   cp .env.local.example .env.local

DATABASE_URL="file:./dev.db"

# Which provider handles a batch: "claude" | "gemini"
TRANSLATION_PROVIDER=claude
DEFAULT_MAX_CHARS=3000

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional (defaults: claude-opus-5 / medium)
# TRANSLATION_MODEL=claude-opus-5
# TRANSLATION_EFFORT=medium

# --- Gemini (Google) ---
GEMINI_API_KEY=AIza...
# Optional (defaults to gemini-flash-latest; Pro has zero free-tier quota)
# GEMINI_MODEL=gemini-flash-latest
