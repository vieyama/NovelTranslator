# Template for the env files — safe to commit. Copy to BOTH:
#   cp .env.local.example .env.local   # read by `bun run dev` (Next.js)
#   cp .env.local.example .env         # read by `docker compose` + Prisma CLI
# then fill in the real values. Neither .env nor .env.local is committed.

# Local dev Postgres — run via `docker compose up -d db` (docker-compose.yml),
# exposed on 127.0.0.1:5439 to avoid clashing with a system-wide Postgres on 5432.
#
# Host-side only: `bun run dev`, `prisma studio`, `prisma migrate dev`. The
# containers do NOT use this value — inside the Compose network the database is
# `db:5432`, and docker-compose.yml builds their DATABASE_URL from POSTGRES_*
# below. See SPEC.md §7.
DATABASE_URL="postgresql://db_user:db_password@localhost:5439/db_name?schema=public"

# --- docker compose only (compose fails fast if any is missing) ---
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name
# Host port the app is published on. APP_BIND_ADDRESS defaults to 0.0.0.0
# (the VPS sets it explicitly); DB_BIND_ADDRESS defaults to 127.0.0.1.
APP_PORT=3007

# --- Auth & encryption (SPEC.md §8) ---
# Both are 32 random bytes: openssl rand -base64 32
# Session cookie signing key for NextAuth.
AUTH_SECRET=
# Root key for API keys stored in the database. It is deliberately NOT in the
# database — that is the whole point: a stolen DB dump without this value
# cannot decrypt anyone's API key. LOSING IT MAKES EVERY STORED API KEY
# PERMANENTLY UNREADABLE (users just re-enter theirs in Settings).
APP_ENCRYPTION_KEY=

# Default account, created on deploy by the `migrate` service if this email
# doesn't exist yet (min 10 characters). Optional — leave blank and create
# accounts by hand instead:
#   bun run user:create you@example.com
# An account that already exists is never modified, so changing the password
# here later does nothing; that is deliberate, so a stale value can't become a
# permanent way in.
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=

# --- Translation defaults ---
# Per-user settings in the database win over everything below; these are the
# fallback for a user who hasn't configured their own provider/model/API key.
# Which provider handles a batch: "claude" | "gemini"
TRANSLATION_PROVIDER=claude
DEFAULT_MAX_CHARS=3000

# All three provider keys below are OPTIONAL and interchangeable in status:
# each user stores their own key in Settings (encrypted, SPEC.md §8.3), and
# these are only the fallback for a user who hasn't. Leave blank any provider
# you don't run from the server.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional (defaults: claude-opus-5 / medium)
# TRANSLATION_MODEL=claude-opus-5
# TRANSLATION_EFFORT=medium

# --- Mistral ---
MISTRAL_API_KEY=
# Optional (defaults to mistral-large-latest)
# MISTRAL_MODEL=mistral-large-latest

# --- OpenRouter (gateway ke ~400 model lintas vendor) ---
OPENROUTER_API_KEY=
# Optional (defaults to openai/gpt-4o). Model ids are vendor-prefixed.
# OPENROUTER_MODEL=openai/gpt-4o
# Optional attribution shown on OpenRouter's public leaderboards. The site URL
# falls back to AUTH_URL, the name to "Novel Translator"; both are omitted when
# empty rather than sent blank.
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# --- Gemini (Google) ---
GEMINI_API_KEY=AIza...
# Optional (defaults to gemini-flash-latest; Pro has zero free-tier quota)
# GEMINI_MODEL=gemini-flash-latest
