// Data model for Novel Translator — see SPEC.md §2 and GLOSSARY.md.
//
// Prisma 7: the datasource URL lives in prisma.config.ts (which loads .env),
// not here. Re-run `npx prisma generate` after editing this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // scrypt, format documented in src/lib/password.ts. Never a raw digest.
  passwordHash String
  // This user's data key, encrypted with APP_ENCRYPTION_KEY (env, never stored
  // here) and bound to `id` as AAD — see src/lib/crypto.ts. Losing the env key
  // makes every API key below unreadable; that is the intended tradeoff.
  encryptedDek String
  // Which provider the user's translations run through: "claude" | "gemini".
  aiProvider   String   @default("claude")
  createdAt    DateTime @default(now())

  books          Book[]
  aiCredentials  AiProviderCredential[]
  apiKeys        ApiKey[]
}

// One row per (user, provider): the *settings* for that provider — which model,
// and which saved key is currently in use. Switching provider in Settings
// therefore doesn't discard what was configured for the other one.
model AiProviderCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "claude" | "gemini" | "mistral" | "openrouter" — matches ProviderName.
  provider String
  // Null = fall back to the provider client's built-in default model.
  model    String?

  // Which of this provider's saved keys translations run under. Null = none
  // chosen, in which case the server env var is used instead.
  //
  // `SetNull` rather than `Cascade`: deleting the key you were using must not
  // delete the model setting with it — it should just leave the provider
  // without an active key.
  activeKeyId String? @unique
  activeKey   ApiKey? @relation("ActiveKey", fields: [activeKeyId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// A saved API key. Several per provider is the point (SPEC.md §8.5): free
// tiers run out, and rotating used to mean pasting a key back in from
// somewhere else every time.
model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String
  /// User-facing name, e.g. "Akun utama" — the only way to tell two masked
  /// keys apart in the list.
  label String

  // AES-256-GCM under the user's DEK, AAD = "<userId>:<provider>" — deliberately
  // the *same* AAD as before this table existed, so the migration could move
  // existing ciphertexts across with plain SQL. Re-encrypting would have meant
  // decrypting during a migration, which needs the master key and cannot be
  // done in SQL at all.
  encryptedApiKey String

  createdAt  DateTime  @default(now())
  /// Set when a translation actually runs with this key, so an exhausted one
  /// can be recognised by when it was last useful.
  lastUsedAt DateTime?

  activeFor AiProviderCredential? @relation("ActiveKey")

  @@index([userId, provider])
}

model Book {
  id              String   @id @default(cuid())
  title           String
  author          String?
  sourceFormat    String // "txt" | "epub" | "pdf"
  totalParagraphs Int
  createdAt       DateTime @default(now())

  // Nullable only because books predate authentication: the migration that
  // added this column had to run against a database that already had rows.
  // Every query filters on it, so an unclaimed book is invisible until
  // `bun run user:create` assigns it — which the first user created does
  // automatically. Treat it as required in application code.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paragraphs    Paragraph[]
  progress      ReadingProgress?
  glossaryTerms GlossaryTerm[]

  @@index([userId])
}

model Paragraph {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Absolute order within the book, starting at 0. Single source of truth for
  // ordering and progress — never infer position by text matching.
  orderIndex   Int
  chapterIndex Int?
  originalText String

  // Null = not yet translated, so untranslated paragraphs are a simple query.
  translatedText String?
  charCount      Int
  translatedAt   DateTime?

  // Which provider and model produced `translatedText`, as "provider:model"
  // (e.g. "gemini:gemini-flash-latest"). Null for rows translated before this
  // column existed — displayed as "tidak diketahui" rather than guessed at.
  //
  // Without it, switching model in Settings leaves no way to tell which
  // paragraphs came from the model you were unhappy with, which is what makes
  // "re-translate the bad ones" actionable at all (SPEC.md §3.6).
  translatedBy String?

  // One level of undo for re-translation. Re-translating overwrites text the
  // reader may have preferred, and the whole point of the feature is trying a
  // different model *to see* — an experiment with no way back is a trap.
  // Only ever written by the re-translate path; a first translation leaves
  // these null.
  previousTranslatedText String?
  previousTranslatedBy   String?

  @@unique([bookId, orderIndex])
  @@index([bookId, orderIndex])
}

model ReadingProgress {
  bookId String @id
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Kept separate: translation may run ahead of reading, and the user may
  // re-read earlier parts. -1 means "nothing yet".
  lastTranslatedIndex Int      @default(-1)
  lastReadIndex       Int      @default(-1)
  updatedAt           DateTime @updatedAt
}

// Per-book terminology, injected into every translation prompt so names and
// invented terms stay consistent across batches (GLOSSARY.md).
model GlossaryTerm {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Original English term.
  term        String
  // Indonesian form, or null = "keep unchanged".
  translation String?
  // "character" | "place" | "term" | "title" | "skill" | "item" | "honorific"
  category    String?
  note        String?

  @@unique([bookId, term])
  @@index([bookId])
}
